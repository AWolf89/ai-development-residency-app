# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# Supabase (E3 — Database & security foundation). Both values are safe to be
# public (the publishable/anon key is still restricted by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret (service-role) key — SERVER ONLY. Used by the reference-data
# import script (E4) to write read-only reference tables; it bypasses Row Level
# Security, so it must NEVER be exposed to the browser or prefixed NEXT_PUBLIC_.
# Leave blank unless you are running `npm run reference:import`.
SUPABASE_SECRET_KEY=

# O*NET release label recorded with imported O*NET rows (e.g. 29.1). Optional.
ONET_RELEASE=

# OpenRouter (E6 — AI foundation, Week 4). The model-gateway API key. SERVER ONLY —
# only src/lib/llm/ and src/app/api/ read it; it must NEVER be prefixed NEXT_PUBLIC_ or
# committed. Set a per-key credit limit in the OpenRouter dashboard (guards runaway cost).
# Create a key at openrouter.ai → Keys; add it here and in Vercel → Environment Variables.
OPENROUTER_API_KEY=

# Optional: public site URL sent to OpenRouter as the HTTP-Referer attribution header.
# Safe to be public. Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=

# Optional: override the OpenRouter base URL. Leave blank for OpenRouter; set only to point
# the gateway at a fake server in local experiments. Automated tests inject their own fetch.
OPENROUTER_BASE_URL=
