# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# Supabase (E3 — Database & security foundation). Both values are safe to be
# public (the publishable/anon key is still restricted by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret (service-role) key — SERVER ONLY. Used by the reference-data
# import script (E4) to write read-only reference tables; it bypasses Row Level
# Security, so it must NEVER be exposed to the browser or prefixed NEXT_PUBLIC_.
# Leave blank unless you are running `npm run reference:import`.
SUPABASE_SECRET_KEY=

# O*NET release label recorded with imported O*NET rows (e.g. 29.1). Optional.
ONET_RELEASE=
