{
  "name": "ai-development-residency-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:llm": "tsx --conditions=react-server tests/llm/mock-run.test.mts",
    "test:rag": "tsx --conditions=react-server tests/rag/mock-rag.test.mts",
    "test:gap": "tsx --conditions=react-server tests/gap/mock-gap.test.mts",
    "test:interview": "tsx --conditions=react-server tests/interview/mock-interview.test.mts",
    "test:investigation": "tsx --conditions=react-server tests/investigation/mock-investigation.test.mts",
    "test:reviewer": "tsx --conditions=react-server tests/reviewer/mock-reviewer.test.mts",
    "test:claims": "tsx --conditions=react-server tests/claims/mock-claims.test.mts",
    "test:proposal": "tsx --conditions=react-server tests/file-analysis/mock-proposal.test.mts",
    "test:reconciliation": "tsx --conditions=react-server tests/file-analysis/mock-reconciliation.test.mts",
    "test:orchestrator": "tsx --conditions=react-server tests/orchestrator/mock-orchestrator.test.mts",
    "llm:check": "python3 tools/llm/check_llm_usage.py",
    "llm:models": "python3 tools/llm/check_models.py",
    "reference:import": "tsx scripts/import-reference-data.ts",
    "rag:index": "tsx --conditions=react-server scripts/index-reference-chunks.ts",
    "rag:eval": "python3 tools/rag/eval_retrieval.py --questions tests/rag/retrieval_questions.json --out docs/rag/retrieval-report.md",
    "test:a11y": "playwright test",
    "a11y:report": "python3 tools/a11y/summarize_axe.py --dir a11y-results/axe --out docs/accessibility/axe-report.md",
    "a11y:contrast": "python3 tools/a11y/check_contrast.py a11y-contrast.json",
    "eval:build": "python3 tools/evals/build_promptfoo_tests.py --cases evals/chat/cases.jsonl --out evals/chat/tests.generated.json --min-per-category 0",
    "eval:run": "npm run eval:build && PROMPTFOO_DISABLE_TELEMETRY=1 promptfoo eval -c promptfooconfig.yaml -o evals/results/latest.json",
    "eval:report": "python3 tools/evals/summarize_run.py evals/results/latest.json --min-pass 0.9 --out docs/evals/latest.md",
    "eval:agents:build": "python3 tools/evals/build_agent_tests.py --cases evals/agents/cases.jsonl --fixtures evals/agents/fixtures.json --out evals/agents/tests.generated.json",
    "eval:agents:selftest": "tsx tools/evals/agents_selftest.mts",
    "eval:agents": "npm run eval:agents:build && PROMPTFOO_DISABLE_TELEMETRY=1 promptfoo eval -c promptfooconfig.agents.yaml -o evals/results/agents.json",
    "eval:agents:report": "python3 tools/evals/summarize_run.py evals/results/agents.json --min-pass 0.9 --out docs/evals/agents-latest.md"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "ai": "7.0.150",
    "mammoth": "^1.13.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "prettier": "^3.9.10",
    "supabase": "2.122.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "3.2.7"
  }
}
